APP_ORIGIN=https://maps.example.com
IMAGE=ghcr.io/optilude/mindspark-home:latest
# Named volume by default. On TrueNAS use a dedicated dataset with UID/GID 1000.
DATA_PATH=mindspark-data
# Bind to the NAS private IP if nginx-proxy-manager runs in another container.
# Only expose this port to your trusted proxy, not to the Internet.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
